# Copy to .env for local development. Real deployments set these as
# platform secrets (Fly.io) instead of committing a .env file.

DATABASE_URL=postgresql+psycopg://garethmiller@localhost/birdphotos
TEST_DATABASE_URL=postgresql+psycopg://garethmiller@localhost/birdphotos_test

# Shared secret the Next.js frontend sends on internal API calls
# (see plan: Auth & Sharing). Any random string is fine locally.
INTERNAL_API_TOKEN=dev-secret-change-me

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=birdphotos

# Claude API (species classification)
ANTHROPIC_API_KEY=

# Google Photos import (see plan: Google Photos Import — risk to spike first)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# The removable AI-trust layer (see plan: Data Model). Keep false until
# you're ready to trust AI species suggestions without manual review.
TRUST_AI_SUGGESTIONS=false
