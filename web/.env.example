# Copy to .env.local for local development. Vercel holds these as
# project env vars in production, not a committed file.

# openssl rand -base64 33
AUTH_SECRET=

# Google OAuth client for *login* — separate from the Google Photos
# import OAuth client (see plan: Auth & Sharing, Google Photos Import).
# Minimal scopes (openid email profile) only.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Only this email may sign in (see plan: single-user gate).
ALLOWED_ADMIN_EMAIL=millerg321@gmail.com

# Database (same Neon instance the worker uses; schema owned by worker/).
# Plain postgresql:// scheme — the `pg` driver, unlike worker/'s SQLAlchemy
# side, does not understand a `+psycopg` dialect suffix.
DATABASE_URL=

# Shared secret sent on calls to the Python worker service.
INTERNAL_API_TOKEN=
WORKER_BASE_URL=http://localhost:8000

# Cloudflare R2 (read access to generate presigned image URLs server-side —
# the bucket is private, not public, so the browser never gets a bare R2
# URL). Same account as worker/.env's R2 credentials.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=birdphotos
